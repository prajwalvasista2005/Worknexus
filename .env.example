# ==============================================================================
# WorkNexus Environment Configuration Template
# Copy this file to .env and configure values before starting the application.
# Do NOT commit .env containing real credentials to version control.
# ==============================================================================

# Application Environment (production, development, test)
ENVIRONMENT=production

# ------------------------------------------------------------------------------
# Security & Cryptography
# ------------------------------------------------------------------------------
# SECRET_KEY must be a cryptographically secure random string with minimum 32 characters.
# Generate a secure key with:
#   openssl rand -hex 32
SECRET_KEY=replace_with_openssl_rand_hex_32_generated_secret_key_min_32_chars

# JWT Algorithm and Expiration
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ------------------------------------------------------------------------------
# PostgreSQL Database Credentials
# ------------------------------------------------------------------------------
# Used by docker-compose database service and connection URL generation.
# Generate a strong password using:
#   openssl rand -base64 24
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_strong_database_password
POSTGRES_DB=SkillSync

# DB connection configuration (used by backend service)
DB_USER=postgres
DB_PASSWORD=replace_with_strong_database_password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=SkillSync

# Explicit DATABASE_URL (if provided, special characters in credentials must be percent-encoded)
# e.g., postgresql://postgres:password@localhost:5432/SkillSync
DATABASE_URL=postgresql://postgres:replace_with_strong_database_password@localhost:5432/SkillSync

# ------------------------------------------------------------------------------
# CORS & Networking
# ------------------------------------------------------------------------------
# Comma-separated list of allowed origins (no trailing slashes)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# Initial Seeding / Demo Accounts
# ------------------------------------------------------------------------------
# Password used only by explicit CLI seeding command (never used in production)
DEMO_ACCOUNT_PASSWORD=replace_with_secure_demo_password

# ------------------------------------------------------------------------------
# Frontend
# ------------------------------------------------------------------------------
VITE_API_URL=http://localhost:8000
